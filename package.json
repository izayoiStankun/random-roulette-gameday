{
  "name": "roulette-broadcast",
  "version": "0.2.0-beta.2",
  "description": "치지직 후원과 OBS를 연동하는 랜덤 룰렛 게임데이 데스크톱 앱",
  "main": "src/main/index.js",
  "author": "Remilegi community",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "suncalc": "^2.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.remilegi.roulettebroadcast",
    "productName": "랜덤룰렛게임데이",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "izayoiStankun",
        "repo": "random-roulette-gameday",
        "channel": "latest"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "random-roulette-gameday-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "random-roulette-gameday-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
